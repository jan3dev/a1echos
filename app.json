{
  "expo": {
    "name": "Echos",
    "slug": "echos",
    "version": "0.4.0",
    "orientation": "default",
    "icon": "./assets/images/icon-dark.png",
    "scheme": "echos",
    "userInterfaceStyle": "automatic",
    "locales": {
      "ar": "./src/localization/ar/native.json",
      "bn": "./src/localization/bn/native.json",
      "es": "./src/localization/es/native.json",
      "fr": "./src/localization/fr/native.json",
      "hi": "./src/localization/hi/native.json",
      "id": "./src/localization/id/native.json",
      "pt": "./src/localization/pt/native.json",
      "ru": "./src/localization/ru/native.json",
      "ur": "./src/localization/ur/native.json",
      "zh-Hans": "./src/localization/zh/native.json"
    },
    "ios": {
      "appleTeamId": "8KC4F7DWTY",
      "buildNumber": "18",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Echos needs access to your microphone to record audio for transcription.",
        "UIBackgroundModes": ["audio"],
        "UILaunchStoryboardName": "SplashScreen"
      },
      "bundleIdentifier": "com.a1lab.echos"
    },
    "android": {
      "versionCode": 11,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ],
      "package": "com.a1lab.echos"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 193,
          "resizeMode": "contain",
          "backgroundColor": "#070708",
          "android": {
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Echos to use Face ID to unlock the app."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ar",
              "bn",
              "es",
              "fr",
              "hi",
              "id",
              "pt",
              "ru",
              "ur",
              "zh-Hans"
            ],
            "android": [
              "en",
              "ar",
              "bn",
              "es",
              "fr",
              "hi",
              "id",
              "pt",
              "ru",
              "ur",
              "zh"
            ]
          }
        }
      ],
      "./plugins/withRnForegroundService",
      "./plugins/withFixJcenter",
      "./plugins/withReactNativeFsFix",
      "./plugins/withFmtConstevalFix",
      "./plugins/withNdkVersion",
      "./plugins/withEchosKeyboard",
      "./plugins/withSqlcipher",
      "./plugins/withFileProtection",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
