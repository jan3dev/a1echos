# Supply-chain hardening: refuse to install any package version published less
# than 7 days ago. pnpm's `minimumReleaseAge` setting takes minutes (not days),
# so 7 days = 7 * 24 * 60 = 10080. Defaults in pnpm v11+: 1440 (1 day).
# For urgent security updates, override per-invocation:
#   corepack pnpm install --config.minimum-release-age=0
minimum-release-age=10080

# Hard-fail if registry metadata is missing the `time` field — otherwise the
# release-age quarantine above can be silently bypassed for any package whose
# metadata lacks a publish time. Default is `true` (skip the check); we tighten
# it for defense-in-depth. If a registry flake makes this noisy, flip back.
minimum-release-age-ignore-missing-time=false

# Auto-install peer dependencies (matches npm v7+ behavior — avoids
# friction from React Native packages with strict peer ranges).
auto-install-peers=true