<!-- Shift, outlined — chevron-up over a base bar drawn as a thin stroke
     over a transparent fill so it reads as a proper outline (the
     previous evenOdd cut-out version was visually almost identical to
     the filled `ic_shift`). Used when shift is OFF; the filled
     `ic_shift` swaps in once the user taps to engage shift. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M12,5L4,13h4v6h8v-6h4L12,5z" />
</vector>
